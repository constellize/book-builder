% Graphics and figures
\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}

% Define pandocbounded command for newer Pandoc versions
\providecommand{\pandocbounded}[1]{#1}

% Pre-define \listoflistings to prevent conflict between minted and pandoc-crossref
\makeatletter
\@ifundefined{listoflistings}{%
  \newcommand{\listoflistings}{\@starttoc{lol}}%
}{}
\makeatother

% Code highlighting with Minted (requires Pygments)
\usepackage[newfloat=false]{minted}
\setminted{
  breaklines=true,
  % true, not false: at a 4.75in measure a token with no spaces in it -- a path like
  % memory-bank/systemPatterns.md, or a long identifier -- cannot break at all and runs
  % straight off the page. Breaking mid-token is less pretty than breaking at a space,
  % and much less ugly than a line in the margin.
  breakanywhere=true,
  breakafter=-./(,
  breakbefore=.,
  breaksymbol=\tiny\ensuremath{\hookrightarrow},
  fontsize=\small,
  xleftmargin=0pt,
  xrightmargin=0pt,
  frame=none,
  framesep=0pt,
  bgcolor=white
}

% Custom callout boxes using tcolorbox
\usepackage{varwidth}  % required by tcolorbox's `varwidth boxed title`, which the
                       % callout filters use so a long promptref title wraps instead
                       % of running off the page. tcolorbox does not load it itself.
\usepackage{tcolorbox}
\tcbuselibrary{breakable,skins}

% The last /DeviceRGB in the file, and PDF/X-1a admits none.
%
% pgfsys-dvipdfmx.def line 305 declares `/pgfprgb [/Pattern /DeviceRGB]` unconditionally
% when pgf loads -- pulled in here by tcolorbox -- as the colour space for UNCOLOURED
% patterns. Re-declaring it is enough to replace it: the resource is emitted as
% \special{pdf:put @pgfcolorspaces << ... >>}, and a later put on the same key wins.
%
% Safe because nothing consumes it. Only \pgfsys@setpatternuncolored references pgfprgb,
% and it emits /pgfpatN; the built PDF contains zero /pgfpat and zero `scn` operators, so
% no pattern colour is ever set. If uncoloured patterns are ever introduced, note that a
% CMYK space wants four components where the RGB one wanted three.
\makeatletter
\pgfutil@addpdfresource@colorspaces{ /pgfprgb [/Pattern /DeviceCMYK] }
\makeatother

% Define callout environments with simple titles
% ---------------------------------------------------------------------------------------
% CALLOUT BREAKS (publisher review item 2)
%
% These boxes must stay breakable -- several run longer than a page -- but nothing governed
% WHERE they broke, so fragments stranded: a lone "}" opening p. 107, and "tainable as they
% grow." opening p. 114 as the tail of an info box.
%
% `lines before break` refuses a break that would leave fewer than N lines in the current
% part, so a box either breaks somewhere sensible or moves whole to the next page. Verified
% as a valid tcolorbox key against this TeX installation before use.
\tcbset{breakable/.append style={lines before break=4}}

\newtcolorbox{codereference}{
  colback=blue!5!white,
  colframe=blue!75!black,
  title={\textbf{Code Reference}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=blue!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{architecture}{
  colback=purple!5!white,
  colframe=purple!75!black,
  title={\textbf{System Architecture}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=purple!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{narrative}{
  colback=gray!5!white,
  colframe=gray!75!black,
  title={\textbf{Narrative Context}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=gray!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{implementation}{
  colback=green!5!white,
  colframe=green!75!black,
  title={\textbf{Implementation Pattern}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=green!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{crossreference}{
  colback=orange!5!white,
  colframe=orange!75!black,
  title={\textbf{Related Components}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=orange!75!black},
  before upper={\parindent15pt}
}

% Chapter and section styling
% ---------------------------------------------------------------------------------------
% FLOAT PLACEMENT (publisher review 2026-10-21, items 1 and 3)
%
% The template had no float control at all, so LaTeX deferred figures and dropped them
% wherever they next fitted -- including into the middle of a breakable callout, and
% between the two halves of a hyphenated word. Reported cases: Figure 4.3 splitting the
% "Design Actionable Health Reporting" callout and tearing its footnote URL in half across
% pp. 104-105; and a full-page figure on p. 34 landing between "Code-" and "Promptu".
%
% [section] makes placeins issue a \FloatBarrier at every \section, so a figure can drift
% within its section but never past it. The fractions make LaTeX place figures on the page
% that references them rather than banking them for a float page: topfraction raised so a
% large figure can still sit at the top of a text page, textfraction lowered so little text
% is required to accompany it, floatpagefraction raised so a float page must be well filled
% before LaTeX chooses one.
\usepackage{needspace}  % used by keep-leadin-with-content.lua
% \needspaceNow: an EAGER \needspace. keep-leadin-with-content.lua uses it in front of a
% longtable and, since round 8, in front of a CALLOUT as well. The two callers need it for
% different reasons; the longtable one is below, and the callout one is this:
%
%   callout-filter-print.lua now sets `breakable=false` on a box that fits a page, so the
%   next legal breakpoint after a lead-in can be a whole unbreakable box away. The stretch
%   glue the lazy \needspace leaves behind then makes a nearly empty page look CHEAP, and
%   TeX takes it: p.118 of the first round-8 build carried three lines and 90% white,
%   shipped at badness 3861 against an alternative break scoring 100000. \needspaceNow emits
%   nothing at all when the room is there, so there is no stretch to exploit.
%
% Do NOT reach for it in front of a HEADING as well. \sectionbreak and friends below are
% deliberately still lazy: making them eager was measured in round 8 and stranded three more
% lead-ins at page feet (the publisher's fault class 4) even though it tidied the whitespace.
% That measurement was repeated in full against the finished round-8 tree and came out the
% same; it is now a documented switch, \headingReserve, which is OFF. See the note there.
%
% \needspace is lazy. It lays down a -100 penalty and stretch glue and lets TeX decide LATER,
% when the page overfills, whether that penalty was the best place to break. In front of a
% longtable "later" is inside the table, where longtable has already replaced \output with
% \LT@output. That routine treats every page break that is not its own as a table break: it
% ships the page and then \copy's the table head onto the top of the next page. The break
% that was meant to sit BEFORE the lead-in is taken there, so the head is copied ahead of the
% lead-in -- a header and rules with no body, above the sentence that introduces the table
% (p.184 of round 7). The lazy break was also being taken with the page half empty, because
% the glue \needspace adds makes that earlier break look cheaper than a break between rows.
%
% This macro decides NOW, while the default \output is still active: if fewer than #1 remain
% on the page it breaks at once; otherwise it emits nothing, so there is no pending penalty
% for longtable to misread. A table that then genuinely runs off the page breaks between rows
% and repeats its head on the continuation page, as longtable intends.
\makeatletter
\newcommand{\needspaceNow}[1]{%
  \par
  \ifdim\pagegoal<\maxdimen % \pagegoal is \maxdimen on an empty page: nothing to protect
    \ifdim\dimexpr\pagegoal-\pagetotal\relax<#1\relax
      \vfil\penalty-\@M
    \fi
  \fi}
\makeatother
% Figures default to [!ht]: placed where they are referenced if at all possible, rather
% than deferred. Deferral is what let a figure drift INTO a breakable callout and split it
% from its own footnote -- Figure 5.4 on p.152 and Figure 7.6 on p.205 both landed between
% a box and its footnote marker. The "!" tells LaTeX to ignore its usual size restrictions
% when deciding, so a tall figure still places rather than being banked for later.
\usepackage{float}
\floatplacement{figure}{!ht}

\usepackage[section]{placeins}
\setcounter{topnumber}{2}
\setcounter{bottomnumber}{1}
\setcounter{totalnumber}{3}
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.5}
\renewcommand{\textfraction}{0.12}
\renewcommand{\floatpagefraction}{0.75}

% ---------------------------------------------------------------------------------------
% WIDOWS, ORPHANS AND BROKEN WORDS (publisher review items 2 and 4)
%
% No penalties were set, so LaTeX's defaults (150) applied -- low enough that it would
% strand a lead-in line such as "The book is organized as follows:" at the foot of p. 32,
% away from the list it introduces. 12 such cases were measurable in the v0.6.0 proof.
%
% \brokenpenalty is the one that matters for the publisher's item 2: it governs a hyphenated
% word broken across a PAGE, which is what produced "main-/tainable" spanning p. 113-114 and
% "Code-/Promptu" spanning a full-page figure. At 10000 TeX will not do it at all.
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000

% ---------------------------------------------------------------------------------------
% VERTICAL JUSTIFICATION: \raggedbottom, overriding the class default. Settled in round 8's
% third pass on a corrected measurement; the reversal recorded in the second pass was taken
% on a metric that could not see the defect it was judging. Read THE PROBLEM, then READ THE
% METRIC FIRST at the end before touching this line.
%
% `book` with `twoside` leaves \flushbottom in force (book.cls only calls \raggedbottom for
% oneside), so every page is stretched to the full text block and the slack is pushed into
% whatever glue exists on the page.
%
% THE PROBLEM THAT IS, with pinned callouts. Since round 8 a callout that fits a page is set
% `breakable=false`, so the next legal breakpoint after a lead-in can be a whole unbreakable
% box away. The page's slack is then stretched into the gap BETWEEN a lead-in and the box it
% introduces -- ~115pt of white between "Critical considerations:" and its box on p.117 of the
% round-8 build -- rather than collecting at the page foot where a reader reads it as a short
% page. The build logged 84 `Underfull \vbox ... while \output is active`, which is that
% stretching, every one of them a page pulled apart to reach the bottom margin.
%
% \raggedbottom lets the page end short and puts the slack at the foot. Measured on this
% 267-page book: page count unchanged, `Underfull \vbox` 84 -> 0, `Overfull \vbox` 0 -> 0,
% and no change to the detected fault classes.
%
% IT WAS A HOUSE-STYLE DECISION, taken by the book's owner for this book: six body-text pages
% were filling to 15-40% because the slack was going into mid-page gaps. A trade book is
% normally set flush bottom; it was ragged bottom here because the pinned boxes make flush
% bottom lie about where the white space is.
%
% IT WENT BACK TO \flushbottom ONCE, IN ROUND 8's SECOND PASS, AND THAT WAS A MISTAKE. The
% argument was that \raggedbottom does not remove slack, it RELOCATES it out of
% inter-paragraph glue into one visible block at the page foot, and so reads as "a lot more
% pages that are mostly empty". The relocation claim is true. The conclusion drawn from it
% was not, because of the metric it was measured with:
%
%   \raggedbottom   269pp   72.5% mean fill    95 pages at 90%+
%   \flushbottom    269pp   74.9% mean fill   116 pages at 90%+
%
% READ THE METRIC FIRST. Those numbers are "mean fill" = the vertical EXTENT the text
% occupies between first and last baseline. That measure REWARDS STRETCHING: a page holding
% three lines of text, a 300pt hole and a figure scores 96%, because the extent runs the
% whole block. It scores a pulled-apart page as full, which is precisely the defect
% \flushbottom creates and precisely what the book's owner was objecting to. The metric was
% structurally incapable of seeing the thing it was being used to judge, so the second pass
% optimised for the wrong direction.
%
% MEASURED AGAIN AS HOLES, not extent -- summing every inter-line gap beyond normal leading,
% which is what a reader actually perceives (scripts in the round-8 scratchpad; the approach
% is the one that matters, not the file). Same book, same 260 pages, same fault classes:
%
%                   holes          pages with a >60pt hole   Underfull \vbox
%   \flushbottom    41.8 pages'      95                       85
%   \raggedbottom   35.6 pages'      75                        0
%
% Page count identical, so the ragged setting costs NOTHING in length. It fixed p.105
% (72->32pt hole), p.145 (190->30pt) and most of p.218 (479->255pt). The 85 `Underfull \vbox`
% entries are not cosmetic log noise: each one is a page pulled apart to reach the bottom
% margin, which is the mid-page white between a lead-in and its pinned box described above.
%
% So: do not revert this line on a fill or extent measurement. If it is ever revisited,
% measure holes.
%
% Placed BEFORE the header-includes block on purpose: book-builder is shared, and a consuming
% book that wants ragged bottom can say `\raggedbottom` in its own header-includes and win.
%
% (That block is NOT named here with its pandoc variable syntax, deliberately. pandoc expands
% template variables BEFORE LaTeX sees the percent signs, so writing one inside a comment
% pastes its whole value onto a commented line and leaks every line after the first into the
% document. Doing it here produced `You can't use \spacefactor in vertical mode` from the
% subcaption guard and a build with no pages. The copyright-page comment further down says
% the same thing; believe it.)
\raggedbottom

\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{truncate}

% Customize chapter titles with automatic numbering.
%
% \raggedright is load-bearing. Without it the title is JUSTIFIED across the full measure,
% and because it is set at \Huge in a 4.75in column most titles wrap to two lines -- so TeX
% stretches the inter-word spaces of the first line to fill it:
%
%     The    Intent-Implementation
%     Building from                    Knowledge,
%
% Body text can absorb that stretch invisibly; a two-word line at 25pt cannot.
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\raggedright}
  {\chaptertitlename\ \thechapter}
  {20pt}
  {\Huge\raggedright}

% Customize unnumbered chapter titles (for foreword)
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\huge\bfseries\raggedright}
  {}
  {20pt}
  {\Huge\raggedright}

% Keep a heading with what follows it.
%
% LaTeX already guards against an orphaned heading, but only when a PARAGRAPH follows: it
% raises \clubpenalty for that paragraph via \@afterheading. When a FIGURE follows instead
% the guard does not apply, which is how "1.5 The Five Steps of the Constellize Method"
% ended up as the last line of p.44 with its figure and list on p.45.
%
% titlesec calls \sectionbreak and friends immediately before each heading, so reserving
% space there covers every case regardless of what comes next. A subsubsection needs less:
% "1.7.1 The Intent Behind CodePromptu" sat second-to-last on p.47 above only a footnote.
%
% LAZY OR EAGER: \headingReserve is the switch, and it is LAZY by default -- which is the
% behaviour this book ships. Point it at \needspaceNow and every heading reservation below
% becomes eager; left at \needspace it is byte-for-byte what it was before the switch
% existed (verified: the print build is identical with the switch in place).
%
% To turn eager on, change the \providecommand line below to
%
%   \providecommand{\headingReserve}{\needspaceNow}
%
% which is the route that was measured. A consuming book can instead say
% \renewcommand{\headingReserve}{\needspaceNow} in its own header-includes, which pandoc
% inserts further down this preamble -- \renewcommand, not \providecommand, because the
% line below has already defined it. \sectionbreak expands \headingReserve at use time, so
% a later redefinition takes effect.
%
% WHY IT IS OFF. Eager was built and measured against lazy on this 267-page book in round 8,
% with \raggedbottom already in force and the pre-flight fit check running. Full numbers:
%
%   book/.superpowers/sdd/2026-11-02-round-8-typesetting-and-ch9/task-8-report.md
%
% Eager does what it claims LOCALLY: the six body pages the owner complained about filled
% from 4-10 body lines to 14-25. But it moved no white space out of the book -- both builds
% set the same 5502 body lines in the same 267 pages, and the count of pages under 20 body
% lines was 106 BEFORE AND AFTER. The slack simply reappeared elsewhere, including two new
% near-empty body pages (3 lines and 2 lines) that are worse than anything it fixed.
%
% And it cost the publisher's fault class 4: stranded lead-ins went 3 -> 6. All three new
% ones are the same shape -- a lead-in whose pinned callout has a TWO-LINE title, which the
% 9-line reservation in keep-leadin-with-content.lua does not cover. Filling the page is
% what pushes those pairs down to the page foot where that gap shows. Raising the callout
% reservation to 12 recovered only one of the three (class 4 = 5, still worse than 3).
%
% The reservation SIZE is not the lever either: eager at 5/4/3 instead of 7/6/5 produced an
% identical book on every measure, down to the same six class-4 findings.
%
% WHERE THE SHORT PAGES ACTUALLY COME FROM. Removing heading reservations altogether -- the
% most this knob can possibly do -- moved pages under 20 lines only 106 -> 104. Of the 41
% pages under 10 body lines, 21 are structural (blank versos, chapter openers, the page
% before a chapter opener) and 8 end short because the next page opens with a pinned callout
% that would not fit. The heading reservation is not what makes this book's pages short, so
% changing how it decides cannot be what fixes them.
% ROUND 8, SECOND PASS: THE RESERVATIONS ARE OFF. The three hooks expand to nothing.
%
% Everything above stands and was measured honestly, but it was all measured in BODY LINES
% PER PAGE -- "pages under 20 lines", which removing reservations moved only 106 -> 104. That
% metric is blind to the fault the book's owner was actually looking at. Measured instead as
% the VERTICAL EXTENT the text occupies on each page, against the round-7 build the publisher
% returned (257pp, 78.8% mean fill, 139 pages at 90%+ fill):
%
%   reservations on, 7/6/5    269pp   74.9% mean fill   116 pages at 90%+
%   reservations off          267pp   77.3% mean fill   141 pages at 90%+
%
% Twenty-five pages move back into the well-filled band and the book loses two pages. A
% reservation is stretch glue plus a penalty in front of EVERY heading; the lazy \needspace
% leaves that glue behind wherever TeX declines the break, and across a book with this many
% headings it is the single largest source of slack in the page.
%
% WHAT IT COSTS: the publisher's fault class 4 (lead-ins stranded at a page foot) goes 3 -> 7.
% Two of those seven are detector false positives -- ordinary mid-paragraph lines, not
% lead-ins -- and the rest are colon lead-ins in chapters the reservations were not protecting
% in the first place; they arrive because the page reflowed, not because a guard was removed.
% That is a real but weak cost against twenty-five pages, and the owner took the trade.
%
% A consuming book that wants reservations back says so in its own header-includes, which
% pandoc inserts further down this preamble -- \renewcommand, because these are defined here:
%
%   \renewcommand{\sectionbreak}{\headingReserve{7\baselineskip}}
%   \renewcommand{\subsectionbreak}{\headingReserve{6\baselineskip}}
%   \renewcommand{\subsubsectionbreak}{\headingReserve{5\baselineskip}}
%
% \headingReserve stays defined so that route needs nothing else, and so the eager/lazy switch
% documented above still works for a book that opts in.
\providecommand{\headingReserve}{\needspace}
\newcommand{\sectionbreak}{}
\newcommand{\subsectionbreak}{}
\newcommand{\subsubsectionbreak}{}

% Customize section titles
\titleformat{\section}
  {\normalfont\Large\bfseries}
  {\thesection}
  {1em}
  {}

% Fix running headers to prevent overfull hbox
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
% Truncate the running head so it can never reach the page number. The truncate package
% was already loaded for this and never used: "Chapter 7. Operational Resilience and Site
% Reliability with Constellize" ran the full measure and pushed the folio off the page
% entirely. 0.78 leaves room for a three-digit number plus a gap.
%
% This is the safety net, not the fix — over-long titles are shortened at source as well,
% because a truncated running head with an ellipsis is still a defect, just a tidier one.
% Chapter on the VERSO, section on the RECTO -- the convention LaTeX's own book class
% encodes:
%
%     \@evenhead{\thepage \hfil \leftmark}     verso:  page ... CHAPTER
%     \@oddhead {\rightmark \hfil \thepage}    recto:  SECTION ... page
%
% where \leftmark is the chapter and \rightmark the section. This template had the two
% marks swapped, putting the chapter on the recto. A reader opening a spread should see the
% chapter on the left and their position within it on the right: broad to specific.
%
% It also put the long strings on the wrong side. Chapter titles are the long ones, and on
% the recto they shared the line with the folio -- which is how "Chapter 7. Operational
% Resilience and Site Reliability with Constellize" pushed the page number off the page.
\fancyhead[RE]{\truncate{0.78\headwidth}{\nouppercase{\leftmark}}}
\fancyhead[LO]{\truncate{0.78\headwidth}{\nouppercase{\rightmark}}}
\renewcommand{\headrulewidth}{0.4pt}

% Fix header height warning
\setlength{\headheight}{14pt}

% Links and URLs - hyperref loaded by pdfx but with print settings
% Line breaking for a narrow measure.
%
% The 6x9 trim gives a 4.75in text block, down from 6.5in at US Letter. At 11pt that is a
% short line, and TeX's default tolerance was overrunning the outer margin on 64 of 111
% pages -- up to 18pt past the edge on recto. Nothing reported it: pandoc runs xelatex in a
% temp directory and discards the log, so the Overfull \hbox warnings never reached us.
%
% emergencystretch lets TeX stretch interword space as a LAST resort rather than letting a
% line run into the margin; tolerance raises the badness it will accept before doing so.
% These are the conventional values for a narrow measure, not guesses.
\setlength{\emergencystretch}{3em}
\tolerance=2000
\hbadness=2000   % stop logging the merely-loose lines this permits

% xurl allows a break at any character in a URL. The promptref callouts carry long paths
% like https://constellize.com/prompts/v1/achieve-documentation-completeness, which are
% unbreakable to plain `url` and were the single worst source of overruns.
\usepackage{xurl}
\usepackage{url}

% ...but "any character" includes letters, so a URL breaks mid-word. The publisher's
% round-6 proof showed /implement-actionable-health-reporting split as "-h" / "ealth-
% reporting" in a footnote on p.105, which reads as a typo rather than a line break.
%
% Plain `url` is no good either: its \UrlBigBreaks nominally handles the hyphen, but a
% slug like achieve-documentation-completeness does not break at its hyphens in practice
% and simply overruns -- measured at 31.6pt past a 1.8in measure, which is the fault xurl
% was brought in to cure.
%
% So: structural characters AND the hyphen, but no letters. Breaks land at `/`, `.` and
% `-`, never inside a word. Measured across both of the book's longest prompt URLs at
% 1.8in, 2.2in and 3.8in measures: zero overfull boxes at every width, where structural-
% without-hyphen overran at the two narrow ones. The footnote measure is ~3.8in, where
% the p.105 URL now breaks as "...implement-actionable-" / "health-reporting".
%
% Must come after xurl, which sets \UrlBreaks at load.
\def\UrlBreaks{\do\.\do\@\do\\\do\/\do\!\do\_\do\|\do\;\do\>\do\]%
  \do\)\do\,\do\?\do\&\do\'\do+\do\=\do\#\do\:\do\-}

% Bibliography
$if(natbib)$
\usepackage{natbib}
\bibliographystyle{$if(biblio-style)$$biblio-style$$else$plainnat$endif$}
$endif$

$if(biblatex)$
\usepackage[$if(biblio-style)$style=$biblio-style$,$endif$$for(biblatexoptions)$$biblatexoptions$$sep$,$endfor$]{biblatex}
$for(bibliography)$
\addbibresource{$bibliography$}
$endfor$
$endif$

% Index
$if(book-style)$
\usepackage{makeidx}
\makeindex
$endif$

% Header includes
$for(header-includes)$
$header-includes$
$endfor$

% Title page
\title{$title$$if(subtitle)$\\[0.5em]{\large $subtitle$}$endif$}
$if(author)$
\author{$for(author)$$author$$sep$ \and $endfor$}
$endif$
$if(date)$
\date{$date$}
$endif$

% Stamp the edition under the date, so a printed copy says which draft it is.
% Reviewers end up with several of these on a desk and no way to tell them apart --
% the copyright page used to carry it, and the publisher now supplies that page, so
% without this the version appears nowhere a reader can see.
$if(edition)$
\date{$if(date)$$date$\\[0.8em]$endif$\normalsize\textit{$edition$}}
$endif$

\begin{document}

% Title page
$if(title)$
\maketitle
$endif$

% Copyright page -- REMOVED. The publisher supplies it.
%
% Their production lead, 2026-10-20: "The copyright pages are missing -- we supply them;
% you don't need to write one." Spines produces the copyright page and the cover files,
% for print and ebook both. Ours named a different publisher from theirs.
%
% DELETED rather than commented, and this comment contains no pandoc variables, because
% pandoc expands template variables BEFORE LaTeX sees the percent signs. Commenting the
% block put the disclaimer's continuation lines outside the comment and broke the build.
% Writing the word for a variable inside THIS comment then leaked that same text onto
% page two. A pandoc template has no safe way to comment out a directive: remove it.
%
% To restore the page, take the block from git history. The fields it read are still live
% in templates/metadata.yaml and still stamp other formats. The edition now prints on the
% title page instead, which is where a reviewer can actually see it.

% Table of contents (no hyperlinks in print version)
$if(toc)$
{
\setcounter{tocdepth}{$toc-depth$}
% The book class sizes the page-number box at 1.55em and the right margin at 2.55em, which
% fits two digits. This book's numbers run to three digits, so the box overflowed, the
% numbers sat at ragged right edges, and a title that filled its line ran straight into the
% number ("...Systematic Planning189", 7.4). 2.4em holds three digits of the body face with
% room to spare; the margin stays 1em wider than the box so a title always leaves a gap and
% leaders. Local to this group, so nothing else that uses \@pnumwidth is affected.
\makeatletter
\renewcommand{\@pnumwidth}{2.4em}
\renewcommand{\@tocrmarg}{3.4em}
\makeatother
\tableofcontents
}
$endif$

% List of figures
$if(lof)$
\listoffigures
$endif$

% List of tables
$if(lot)$
\listoftables
$endif$

% Clear the running marks the front matter just set.
% \tableofcontents issues \chapter*{Contents} with \@mkboth, which sets BOTH \leftmark and
% \rightmark to "Contents". The foreword that follows is a \section (it is `## Foreword` in
% markdown, not `#`), and a section only updates \rightmark -- so \leftmark kept saying
% "Contents" for 30 pages, until the first real \chapter finally issued a \chaptermark.
\markboth{}{}

% Main content
$body$

% Bibliography
$if(natbib)$
$if(bibliography)$
$if(biblio-title)$
$if(book-class)$
\renewcommand\bibname{$biblio-title$}
$else$
\renewcommand\refname{$biblio-title$}
$endif$
$endif$
\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}
$endif$
$endif$

$if(biblatex)$
\printbibliography$if(biblio-title)$[title=$biblio-title$]$endif$
$endif$

% Index
$if(book-style)$
\printindex
$endif$

\end{document}