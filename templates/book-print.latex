% Constellize Book LaTeX Template - Print Version
% PDF/X-1a compliant template for professional printing

\documentclass[$if(fontsize)$$fontsize$,$endif$$if(lang)$$babel-lang$,$endif$$if(papersize)$$papersize$paper,$endif$$for(classoption)$$classoption$$sep$,$endfor$]{$documentclass$}

% Fix for Pandoc's tightlist command - must be early
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Page geometry: 6x9in trade trim per the publisher's spec (Lightning Source).
% Inner (gutter) 0.75in is the top of their 0.5-0.75in range -- the trim change takes the
% extent from 188pp to ~250pp, and the thicker the book the more the binding eats.
% No bleed: nothing in the design runs to the page edge, so the spec says none.
%
% LOAD ORDER IS LOAD-BEARING: geometry MUST come before pdfx. pdfx pins the PDF page size
% when it loads, so with pdfx first, geometry still narrows the text block -- the page count
% changes, which looks like it worked -- while the sheet stays Letter. Verified: pdfx-then-
% geometry gives 612x792pt, geometry-then-pdfx gives 432x648pt = exactly 6x9in.
\usepackage[paperwidth=6in,paperheight=9in,
            inner=0.75in,outer=0.5in,top=0.75in,bottom=0.75in,
            footskip=0.35in]{geometry}

% PDF/X-1a:2001 compliance, as specified by the publisher (Lightning Source).
% `x-1a1` is the 2001 part; plain `x-1a` emits :2003, which is also inconsistent with
% the PDF 1.3 output this produces -- :2003 is defined against PDF 1.4.
\usepackage[x-1a1]{pdfx}
\usepackage[cmyk]{xcolor}

% Font setup
\usepackage{fontspec}

% Atkinson Hyperlegible fonts with absolute paths
\setmainfont{AtkinsonHyperlegibleNext-Regular.ttf}[
  Path = ./book-builder/fonts/,
  BoldFont = AtkinsonHyperlegibleNext-Bold.ttf,
  ItalicFont = AtkinsonHyperlegibleNext-RegularItalic.ttf,
  BoldItalicFont = AtkinsonHyperlegibleNext-BoldItalic.ttf,
  Ligatures = TeX
]

\setsansfont{AtkinsonHyperlegibleNext-Regular.ttf}[
  Path = ./book-builder/fonts/,
  BoldFont = AtkinsonHyperlegibleNext-Bold.ttf,
  ItalicFont = AtkinsonHyperlegibleNext-RegularItalic.ttf,
  BoldItalicFont = AtkinsonHyperlegibleNext-BoldItalic.ttf,
  Ligatures = TeX
]

\setmonofont{AtkinsonHyperlegibleMono-Regular.ttf}[
  Path = ./book-builder/fonts/,
  BoldFont = AtkinsonHyperlegibleMono-Bold.ttf,
  ItalicFont = AtkinsonHyperlegibleMono-RegularItalic.ttf,
  BoldItalicFont = AtkinsonHyperlegibleMono-BoldItalic.ttf,
  Scale = 0.9
]

% Add symbol support
\usepackage{newunicodechar}
\newfontfamily\symbolfont{Menlo}[Scale=0.9]

% Add checkmark symbol
\usepackage{amssymb}

% Define checkmark symbols with fallback
\newunicodechar{✓}{\checkmark}
\newunicodechar{✔}{\checkmark}
\newunicodechar{✅}{\checkmark}

% Define tree drawing characters
% The main font has no arrow. Verified: AtkinsonHyperlegibleNext-Regular.ttf does not map
% U+2192, which is why 26 arrows across 12 pages printed as empty boxes. \symbolfont is
% Menlo, already loaded below for box drawing, and Menlo does map U+2192.
\newunicodechar{→}{\symbolfont →}
% ❌ U+274C is an emoji; neither the text font nor Menlo maps it. ✗ U+2717 BALLOT X reads
% identically in body text and Menlo does map it. This is the counterpart of the ✓ mapping
% below -- the two appear as a pair in the manuscript.
\newunicodechar{❌}{\symbolfont ✗}
\newunicodechar{✗}{\symbolfont ✗}
\newunicodechar{←}{\symbolfont ←}
\newunicodechar{↔}{\symbolfont ↔}
\newunicodechar{⇒}{\symbolfont ⇒}
\newunicodechar{├}{\symbolfont ├}
\newunicodechar{─}{\symbolfont ─}
\newunicodechar{└}{\symbolfont └}
\newunicodechar{│}{\symbolfont │}

% Remove emojis completely - they will be stripped from the text during processing
% Define fallback for any remaining emoji characters to be invisible
\newcommand{\stripemoji}[1]{}

% Enhanced typography
\usepackage{microtype}
\usepackage{lettrine}

% Fix for Pandoc's tightlist command
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Fix for Pandoc's citeproc command - define it to just output the formatted citation
\providecommand{\citeproc}[2]{#2}

% Fix for Pandoc's citeproctext command - handle both with and without arguments
\providecommand{\citeproctext}[1][]{\ifx\relax#1\relax\else#1\fi}

% Fix for Pandoc's CSLReferences environment - use list with no labels
\newenvironment{CSLReferences}[2]
  {\begin{list}{}{\setlength{\leftmargin}{#1em}\setlength{\itemindent}{-#1em}\setlength{\itemsep}{0pt}\setlength{\parsep}{0pt}}
   \let\oldmakelabel\makelabel
   \renewcommand{\makelabel}[1]{}
   \let\olditem\item
   \renewcommand{\item}[1][]{\olditem}}
  {\end{list}}

% Page layout: see the geometry block near the top, which MUST precede pdfx.

% Better spacing
\usepackage{setspace}
$if(linestretch)$
\setstretch{$linestretch$}
$else$
\onehalfspacing
$endif$

% Language and encoding - simplified for English
\usepackage{polyglossia}
\setmainlanguage{english}

% Better tables
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{multirow}
\usepackage{wrapfig}
\usepackage{calc}  % Required for Pandoc's proportional table column widths

% Fix for Pandoc's table column width calculations
\makeatletter
\@ifundefined{c@LTchunksize}{\newcounter{LTchunksize}}{}
% Define the 'none' counter that Pandoc's table code references
\@ifundefined{c@none}{\newcounter{none}}{}
\providecommand{\LT@none}{}
\makeatother

% Graphics and figures
\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}

% Define pandocbounded command for newer Pandoc versions
\providecommand{\pandocbounded}[1]{#1}

% Pre-define \listoflistings to prevent conflict between minted and pandoc-crossref
\makeatletter
\@ifundefined{listoflistings}{%
  \newcommand{\listoflistings}{\@starttoc{lol}}%
}{}
\makeatother

% Code highlighting with Minted (requires Pygments)
\usepackage[newfloat=false]{minted}
\setminted{
  breaklines=true,
  % true, not false: at a 4.75in measure a token with no spaces in it -- a path like
  % memory-bank/systemPatterns.md, or a long identifier -- cannot break at all and runs
  % straight off the page. Breaking mid-token is less pretty than breaking at a space,
  % and much less ugly than a line in the margin.
  breakanywhere=true,
  breakafter=-./(,
  breakbefore=.,
  breaksymbol=\tiny\ensuremath{\hookrightarrow},
  fontsize=\small,
  xleftmargin=0pt,
  xrightmargin=0pt,
  frame=none,
  framesep=0pt,
  bgcolor=white
}

% Custom callout boxes using tcolorbox
\usepackage{varwidth}  % required by tcolorbox's `varwidth boxed title`, which the
                       % callout filters use so a long promptref title wraps instead
                       % of running off the page. tcolorbox does not load it itself.
\usepackage{tcolorbox}
\tcbuselibrary{breakable,skins}

% The last /DeviceRGB in the file, and PDF/X-1a admits none.
%
% pgfsys-dvipdfmx.def line 305 declares `/pgfprgb [/Pattern /DeviceRGB]` unconditionally
% when pgf loads -- pulled in here by tcolorbox -- as the colour space for UNCOLOURED
% patterns. Re-declaring it is enough to replace it: the resource is emitted as
% \special{pdf:put @pgfcolorspaces << ... >>}, and a later put on the same key wins.
%
% Safe because nothing consumes it. Only \pgfsys@setpatternuncolored references pgfprgb,
% and it emits /pgfpatN; the built PDF contains zero /pgfpat and zero `scn` operators, so
% no pattern colour is ever set. If uncoloured patterns are ever introduced, note that a
% CMYK space wants four components where the RGB one wanted three.
\makeatletter
\pgfutil@addpdfresource@colorspaces{ /pgfprgb [/Pattern /DeviceCMYK] }
\makeatother

% Define callout environments with simple titles
% ---------------------------------------------------------------------------------------
% CALLOUT BREAKS (publisher review item 2)
%
% These boxes must stay breakable -- several run longer than a page -- but nothing governed
% WHERE they broke, so fragments stranded: a lone "}" opening p. 107, and "tainable as they
% grow." opening p. 114 as the tail of an info box.
%
% `lines before break` refuses a break that would leave fewer than N lines in the current
% part, so a box either breaks somewhere sensible or moves whole to the next page. Verified
% as a valid tcolorbox key against this TeX installation before use.
\tcbset{breakable/.append style={lines before break=4}}

\newtcolorbox{codereference}{
  colback=blue!5!white,
  colframe=blue!75!black,
  title={\textbf{Code Reference}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=blue!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{architecture}{
  colback=purple!5!white,
  colframe=purple!75!black,
  title={\textbf{System Architecture}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=purple!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{narrative}{
  colback=gray!5!white,
  colframe=gray!75!black,
  title={\textbf{Narrative Context}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=gray!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{implementation}{
  colback=green!5!white,
  colframe=green!75!black,
  title={\textbf{Implementation Pattern}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=green!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{crossreference}{
  colback=orange!5!white,
  colframe=orange!75!black,
  title={\textbf{Related Components}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=orange!75!black},
  before upper={\parindent15pt}
}

% Chapter and section styling
% ---------------------------------------------------------------------------------------
% FLOAT PLACEMENT (publisher review 2026-10-21, items 1 and 3)
%
% The template had no float control at all, so LaTeX deferred figures and dropped them
% wherever they next fitted -- including into the middle of a breakable callout, and
% between the two halves of a hyphenated word. Reported cases: Figure 4.3 splitting the
% "Design Actionable Health Reporting" callout and tearing its footnote URL in half across
% pp. 104-105; and a full-page figure on p. 34 landing between "Code-" and "Promptu".
%
% [section] makes placeins issue a \FloatBarrier at every \section, so a figure can drift
% within its section but never past it. The fractions make LaTeX place figures on the page
% that references them rather than banking them for a float page: topfraction raised so a
% large figure can still sit at the top of a text page, textfraction lowered so little text
% is required to accompany it, floatpagefraction raised so a float page must be well filled
% before LaTeX chooses one.
\usepackage{needspace}  % used by keep-leadin-with-content.lua
% Figures default to [!ht]: placed where they are referenced if at all possible, rather
% than deferred. Deferral is what let a figure drift INTO a breakable callout and split it
% from its own footnote -- Figure 5.4 on p.152 and Figure 7.6 on p.205 both landed between
% a box and its footnote marker. The "!" tells LaTeX to ignore its usual size restrictions
% when deciding, so a tall figure still places rather than being banked for later.
\usepackage{float}
\floatplacement{figure}{!ht}

\usepackage[section]{placeins}
\setcounter{topnumber}{2}
\setcounter{bottomnumber}{1}
\setcounter{totalnumber}{3}
\renewcommand{\topfraction}{0.85}
\renewcommand{\bottomfraction}{0.5}
\renewcommand{\textfraction}{0.12}
\renewcommand{\floatpagefraction}{0.75}

% ---------------------------------------------------------------------------------------
% WIDOWS, ORPHANS AND BROKEN WORDS (publisher review items 2 and 4)
%
% No penalties were set, so LaTeX's defaults (150) applied -- low enough that it would
% strand a lead-in line such as "The book is organized as follows:" at the foot of p. 32,
% away from the list it introduces. 12 such cases were measurable in the v0.6.0 proof.
%
% \brokenpenalty is the one that matters for the publisher's item 2: it governs a hyphenated
% word broken across a PAGE, which is what produced "main-/tainable" spanning p. 113-114 and
% "Code-/Promptu" spanning a full-page figure. At 10000 TeX will not do it at all.
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000


\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{truncate}

% Customize chapter titles with automatic numbering.
%
% \raggedright is load-bearing. Without it the title is JUSTIFIED across the full measure,
% and because it is set at \Huge in a 4.75in column most titles wrap to two lines -- so TeX
% stretches the inter-word spaces of the first line to fill it:
%
%     The    Intent-Implementation
%     Building from                    Knowledge,
%
% Body text can absorb that stretch invisibly; a two-word line at 25pt cannot.
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\raggedright}
  {\chaptertitlename\ \thechapter}
  {20pt}
  {\Huge\raggedright}

% Customize unnumbered chapter titles (for foreword)
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\huge\bfseries\raggedright}
  {}
  {20pt}
  {\Huge\raggedright}

% Keep a heading with what follows it.
%
% LaTeX already guards against an orphaned heading, but only when a PARAGRAPH follows: it
% raises \clubpenalty for that paragraph via \@afterheading. When a FIGURE follows instead
% the guard does not apply, which is how "1.5 The Five Steps of the Constellize Method"
% ended up as the last line of p.44 with its figure and list on p.45.
%
% titlesec calls \sectionbreak and friends immediately before each heading, so reserving
% space there covers every case regardless of what comes next. A subsubsection needs less:
% "1.7.1 The Intent Behind CodePromptu" sat second-to-last on p.47 above only a footnote.
\newcommand{\sectionbreak}{\needspace{7\baselineskip}}
\newcommand{\subsectionbreak}{\needspace{6\baselineskip}}
\newcommand{\subsubsectionbreak}{\needspace{5\baselineskip}}

% Customize section titles
\titleformat{\section}
  {\normalfont\Large\bfseries}
  {\thesection}
  {1em}
  {}

% Fix running headers to prevent overfull hbox
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
% Truncate the running head so it can never reach the page number. The truncate package
% was already loaded for this and never used: "Chapter 7. Operational Resilience and Site
% Reliability with Constellize" ran the full measure and pushed the folio off the page
% entirely. 0.78 leaves room for a three-digit number plus a gap.
%
% This is the safety net, not the fix — over-long titles are shortened at source as well,
% because a truncated running head with an ellipsis is still a defect, just a tidier one.
% Chapter on the VERSO, section on the RECTO -- the convention LaTeX's own book class
% encodes:
%
%     \@evenhead{\thepage \hfil \leftmark}     verso:  page ... CHAPTER
%     \@oddhead {\rightmark \hfil \thepage}    recto:  SECTION ... page
%
% where \leftmark is the chapter and \rightmark the section. This template had the two
% marks swapped, putting the chapter on the recto. A reader opening a spread should see the
% chapter on the left and their position within it on the right: broad to specific.
%
% It also put the long strings on the wrong side. Chapter titles are the long ones, and on
% the recto they shared the line with the folio -- which is how "Chapter 7. Operational
% Resilience and Site Reliability with Constellize" pushed the page number off the page.
\fancyhead[RE]{\truncate{0.78\headwidth}{\nouppercase{\leftmark}}}
\fancyhead[LO]{\truncate{0.78\headwidth}{\nouppercase{\rightmark}}}
\renewcommand{\headrulewidth}{0.4pt}

% Fix header height warning
\setlength{\headheight}{14pt}

% Links and URLs - hyperref loaded by pdfx but with print settings
% Line breaking for a narrow measure.
%
% The 6x9 trim gives a 4.75in text block, down from 6.5in at US Letter. At 11pt that is a
% short line, and TeX's default tolerance was overrunning the outer margin on 64 of 111
% pages -- up to 18pt past the edge on recto. Nothing reported it: pandoc runs xelatex in a
% temp directory and discards the log, so the Overfull \hbox warnings never reached us.
%
% emergencystretch lets TeX stretch interword space as a LAST resort rather than letting a
% line run into the margin; tolerance raises the badness it will accept before doing so.
% These are the conventional values for a narrow measure, not guesses.
\setlength{\emergencystretch}{3em}
\tolerance=2000
\hbadness=2000   % stop logging the merely-loose lines this permits

% xurl allows a break at any character in a URL. The promptref callouts carry long paths
% like https://constellize.com/prompts/v1/achieve-documentation-completeness, which are
% unbreakable to plain `url` and were the single worst source of overruns.
\usepackage{xurl}
\usepackage{url}

% Bibliography
$if(natbib)$
\usepackage{natbib}
\bibliographystyle{$if(biblio-style)$$biblio-style$$else$plainnat$endif$}
$endif$

$if(biblatex)$
\usepackage[$if(biblio-style)$style=$biblio-style$,$endif$$for(biblatexoptions)$$biblatexoptions$$sep$,$endfor$]{biblatex}
$for(bibliography)$
\addbibresource{$bibliography$}
$endfor$
$endif$

% Index
$if(book-style)$
\usepackage{makeidx}
\makeindex
$endif$

% Header includes
$for(header-includes)$
$header-includes$
$endfor$

% Title page
\title{$title$$if(subtitle)$\\[0.5em]{\large $subtitle$}$endif$}
$if(author)$
\author{$for(author)$$author$$sep$ \and $endfor$}
$endif$
$if(date)$
\date{$date$}
$endif$

% Stamp the edition under the date, so a printed copy says which draft it is.
% Reviewers end up with several of these on a desk and no way to tell them apart --
% the copyright page used to carry it, and the publisher now supplies that page, so
% without this the version appears nowhere a reader can see.
$if(edition)$
\date{$if(date)$$date$\\[0.8em]$endif$\normalsize\textit{$edition$}}
$endif$

\begin{document}

% Title page
$if(title)$
\maketitle
$endif$

% Copyright page -- REMOVED. The publisher supplies it.
%
% Their production lead, 2026-10-20: "The copyright pages are missing -- we supply them;
% you don't need to write one." Spines produces the copyright page and the cover files,
% for print and ebook both. Ours named a different publisher from theirs.
%
% DELETED rather than commented, and this comment contains no pandoc variables, because
% pandoc expands template variables BEFORE LaTeX sees the percent signs. Commenting the
% block put the disclaimer's continuation lines outside the comment and broke the build.
% Writing the word for a variable inside THIS comment then leaked that same text onto
% page two. A pandoc template has no safe way to comment out a directive: remove it.
%
% To restore the page, take the block from git history. The fields it read are still live
% in templates/metadata.yaml and still stamp other formats. The edition now prints on the
% title page instead, which is where a reviewer can actually see it.

% Table of contents (no hyperlinks in print version)
$if(toc)$
{
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
}
$endif$

% List of figures
$if(lof)$
\listoffigures
$endif$

% List of tables
$if(lot)$
\listoftables
$endif$

% Clear the running marks the front matter just set.
% \tableofcontents issues \chapter*{Contents} with \@mkboth, which sets BOTH \leftmark and
% \rightmark to "Contents". The foreword that follows is a \section (it is `## Foreword` in
% markdown, not `#`), and a section only updates \rightmark -- so \leftmark kept saying
% "Contents" for 30 pages, until the first real \chapter finally issued a \chaptermark.
\markboth{}{}

% Main content
$body$

% Bibliography
$if(natbib)$
$if(bibliography)$
$if(biblio-title)$
$if(book-class)$
\renewcommand\bibname{$biblio-title$}
$else$
\renewcommand\refname{$biblio-title$}
$endif$
$endif$
\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}
$endif$
$endif$

$if(biblatex)$
\printbibliography$if(biblio-title)$[title=$biblio-title$]$endif$
$endif$

% Index
$if(book-style)$
\printindex
$endif$

\end{document}