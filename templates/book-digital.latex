% Constellize Book LaTeX Template
% PDF/X-1a compliant template with Atkinson Hyperlegible font

\documentclass[$if(fontsize)$$fontsize$,$endif$$if(lang)$$babel-lang$,$endif$$if(papersize)$$papersize$paper,$endif$$for(classoption)$$classoption$$sep$,$endfor$]{$documentclass$}

% Fix for Pandoc's tightlist command - must be early
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Standard PDF with hyperlinks (not PDF/X-1a for digital use)
\usepackage{xcolor}
\usepackage[unicode=true,
 bookmarks=true,bookmarksnumbered=true,bookmarksopen=false,
 breaklinks=true,colorlinks=true,
 linkcolor=black,citecolor=blue,urlcolor=blue,
 pdfstartview=FitH]{hyperref}

% Font setup
\usepackage{fontspec}

% Atkinson Hyperlegible fonts from book-builder submodule
\setmainfont{AtkinsonHyperlegibleNext-Regular.ttf}[
  Path = ./book-builder/fonts/,
  BoldFont = AtkinsonHyperlegibleNext-Bold.ttf,
  ItalicFont = AtkinsonHyperlegibleNext-RegularItalic.ttf,
  BoldItalicFont = AtkinsonHyperlegibleNext-BoldItalic.ttf,
  Ligatures = TeX
]

\setsansfont{AtkinsonHyperlegibleNext-Regular.ttf}[
  Path = ./book-builder/fonts/,
  BoldFont = AtkinsonHyperlegibleNext-Bold.ttf,
  ItalicFont = AtkinsonHyperlegibleNext-RegularItalic.ttf,
  BoldItalicFont = AtkinsonHyperlegibleNext-BoldItalic.ttf,
  Ligatures = TeX
]

\setmonofont{AtkinsonHyperlegibleMono-Regular.ttf}[
  Path = ./book-builder/fonts/,
  BoldFont = AtkinsonHyperlegibleMono-Bold.ttf,
  ItalicFont = AtkinsonHyperlegibleMono-RegularItalic.ttf,
  BoldItalicFont = AtkinsonHyperlegibleMono-BoldItalic.ttf,
  Scale = 0.9
]

% Add symbol support
\usepackage{newunicodechar}
\newfontfamily\symbolfont{Menlo}[Scale=0.9]

% Add checkmark symbol
\usepackage{amssymb}

% Define checkmark symbols with fallback
\newunicodechar{✓}{\checkmark}
\newunicodechar{✔}{\checkmark}
\newunicodechar{✅}{\checkmark}

% ARROWS AND BALLOT MARKS. These six were in book-print.latex and not here, which is the
% whole of the digital PDF's fault class 5: eighteen replacement characters across eleven
% pages of v0.6.4, every one of them an arrow in a place that reads as an arrow --
% "break down ? capture ? evaluate", "Immediate Cause ? Contributing Factors", "91%?82%".
%
% The main font has no arrow. Verified: AtkinsonHyperlegibleNext-Regular.ttf does not map
% U+2192. \symbolfont is Menlo, already loaded above for the box-drawing characters, and
% Menlo does map it.
%
% U+274C is an emoji; neither the text font nor Menlo maps it. U+2717 BALLOT X reads
% identically in body text and Menlo does map it, so it stands in -- the counterpart of
% the checkmark mapping above, and the two appear as a pair in the manuscript.
%
% Keep this list in sync with book-print.latex. A glyph the manuscript uses and only one
% template maps is invisible in the other, and shows up as a box rather than an error.
\newunicodechar{→}{\symbolfont →}
\newunicodechar{❌}{\symbolfont ✗}
\newunicodechar{✗}{\symbolfont ✗}
\newunicodechar{←}{\symbolfont ←}
\newunicodechar{↔}{\symbolfont ↔}
\newunicodechar{⇒}{\symbolfont ⇒}

% Define tree drawing characters
\newunicodechar{├}{\symbolfont ├}
\newunicodechar{─}{\symbolfont ─}
\newunicodechar{└}{\symbolfont └}
\newunicodechar{│}{\symbolfont │}

% Remove emojis completely - they will be stripped from the text during processing
% Define fallback for any remaining emoji characters to be invisible
\newcommand{\stripemoji}[1]{}

% Enhanced typography
\usepackage{microtype}
\usepackage{lettrine}

% Fix for Pandoc's tightlist command
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Fix for Pandoc's citeproc command - define it to just output the formatted citation
\providecommand{\citeproc}[2]{#2}

% Fix for Pandoc's citeproctext command - handle both with and without arguments
\providecommand{\citeproctext}[1][]{\ifx\relax#1\relax\else#1\fi}

% Fix for Pandoc's CSLReferences environment - use list with no labels
\newenvironment{CSLReferences}[2]
  {\begin{list}{}{\setlength{\leftmargin}{#1em}\setlength{\itemindent}{-#1em}\setlength{\itemsep}{0pt}\setlength{\parsep}{0pt}}
   \let\oldmakelabel\makelabel
   \renewcommand{\makelabel}[1]{}
   \let\olditem\item
   \renewcommand{\item}[1][]{\olditem}}
  {\end{list}}

% ---------------------------------------------------------------------------------------
% PAGE-BREAKING PENALTIES. Ported from book-print.latex, where they were added for the
% publisher's review; this template never got them, and until v0.6.4 the digital PDF was
% carrying faults the print PDF had already fixed.
%
% \brokenpenalty is the one that does the work here. It governs a word hyphenated across a
% PAGE, and at LaTeX's default of 150 TeX will happily do it: eleven cases in v0.6.4,
% "simultane-/ously" across pp.23-24, "Onboard-/ing" across pp.26-27, and two spanning a
% full-page figure. At 10000 it will not do it at all.
%
% \widowpenalty and \clubpenalty govern a break INSIDE a paragraph, one line from either
% end. They are not what holds a lead-in to its list -- that break is between two
% paragraphs, and keep-leadin-with-content.lua handles it -- but they are what lets a
% folded-in bold label be held by the paragraph it now belongs to.
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000

% VERTICAL JUSTIFICATION. \raggedbottom, overriding the book class default of \flushbottom,
% for the same reason print carries it: \brokenpenalty=10000 above takes away TeX's option
% of hyphenating across a page, so it has to find the break elsewhere, and under
% \flushbottom the slack that leaves is distributed as stretch BETWEEN the blocks on the
% page. That is what a reader sees as a hole in the middle of a page. \raggedbottom puts
% the same slack at the page foot instead, where on screen it reads as a margin.
%
% It does not remove whitespace, it relocates it, and that is the whole of the claim.
\raggedbottom

% \needspaceNow: the EAGER \needspace that keep-leadin-with-content.lua reaches for in
% front of a longtable. The filter guards every use with \ifdefined and falls back to the
% lazy \needspace, so a template without this still builds -- it just reintroduces the
% ghost table head that the lazy form causes, because longtable replaces \output and reads
% any foreign page break as a table break, copying the head above the lead-in.
%
% This decides NOW, while the default \output is still active: if fewer than #1 remain on
% the page it breaks at once, otherwise it emits nothing, so no pending penalty is left for
% longtable to misread. See the long note at the same macro in book-print.latex.
%
\usepackage{needspace}  % used by keep-leadin-with-content.lua
\makeatletter
\newcommand{\needspaceNow}[1]{%
  \par
  \ifdim\pagegoal<\maxdimen % \pagegoal is \maxdimen on an empty page: nothing to protect
    \ifdim\dimexpr\pagegoal-\pagetotal\relax<#1\relax
      \vfil\penalty-\@M
    \fi
  \fi}
\makeatother

% Page layout - simple approach without geometry package
\usepackage[letterpaper,margin=1in,bindingoffset=0.2in]{geometry}

% Better spacing
\usepackage{setspace}
$if(linestretch)$
\setstretch{$linestretch$}
$else$
\onehalfspacing
$endif$

% Language and encoding - simplified for English
\usepackage{polyglossia}
\setmainlanguage{english}

% Better tables
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{array}
\usepackage{multirow}
\usepackage{wrapfig}
\usepackage{calc}  % Required for Pandoc's proportional table column widths

% Fix for Pandoc's table column width calculations
\makeatletter
\@ifundefined{c@LTchunksize}{\newcounter{LTchunksize}}{}
% Define the 'none' counter that Pandoc's table code references
\@ifundefined{c@none}{\newcounter{none}}{}
\providecommand{\LT@none}{}
\makeatother

% Graphics and figures
% ---------------------------------------------------------------------------------------
% NO FLOAT CONTROL HERE, AND IT WAS MEASURED. Print's block -- \usepackage{float},
% \floatplacement{figure}{!ht}, \usepackage[section]{placeins} and the four fractions --
% was ported here in full and reverted.
%
% What prompted it: "Key components:" sat at the foot of p.106 of v0.6.4 while Figure 5.1
% and the numbered list it introduces both went to p.107. The markdown has the lead-in
% followed DIRECTLY by its list, so the figure was a deferred float that LaTeX flushed at
% the page break and dropped in between. No reservation can prevent that -- the reservation
% was satisfied; the float arrived afterwards.
%
% Measured on the whole book, against the build with the penalties above and nothing else:
%
%   penalties only            201pp   31.0 pages' worth of holes   83.6pt mean   3 faults
%   + print's float block     199pp   40.8 pages' worth of holes  111.2pt mean   5 faults
%
% Two pages shorter and far worse everywhere that matters: ten more pages' worth of
% whitespace, a third more pages carrying a visible hole, a new orphaned "}" on p.90, and
% one MORE stranded lead-in rather than fewer. It did not even fix the strand it was added
% for -- "Key components:" simply moved to p.102 and stayed at the foot.
%
% Why it helps print and not here: [section] makes placeins issue a \FloatBarrier at every
% \section, and a barrier flushes held floats whether or not the page has room, which is
% what opens the holes. Print accepts that cost because it buys the publisher's fault class
% 1 -- a figure drifting into a breakable callout and tearing its footnote URL in half.
% The digital build does not have that fault: class 1 is already 0 here, because these
% callouts are never pinned and its figures are sized for a wider, taller text block.
%
% So the trade is real in one template and all cost in the other. Leaving \FloatBarrier
% undefined also keeps the barriers keep-leadin-with-content.lua emits under \ifdefined as
% no-ops here, which is a supported configuration of that filter.
\usepackage{graphicx}
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}

% Define pandocbounded command for newer Pandoc versions
\providecommand{\pandocbounded}[1]{#1}

% Code highlighting with Minted (requires Pygments)
\usepackage{minted}
\setminted{
  breaklines=true,
  breakanywhere=false,
  breakafter=-/,
  breaksymbol=\tiny\ensuremath{\hookrightarrow},
  fontsize=\small,
  xleftmargin=0pt,
  xrightmargin=0pt,
  frame=none,
  framesep=0pt,
  bgcolor=white
}

% Custom callout boxes using tcolorbox
\usepackage{tcolorbox}
\tcbuselibrary{breakable,skins}

% Define callout environments with simple titles
\newtcolorbox{codereference}{
  colback=blue!5!white,
  colframe=blue!75!black,
  title={\textbf{Code Reference}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=blue!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{architecture}{
  colback=purple!5!white,
  colframe=purple!75!black,
  title={\textbf{System Architecture}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=purple!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{narrative}{
  colback=gray!5!white,
  colframe=gray!75!black,
  title={\textbf{Narrative Context}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=gray!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{implementation}{
  colback=green!5!white,
  colframe=green!75!black,
  title={\textbf{Implementation Pattern}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=green!75!black},
  before upper={\parindent15pt}
}

\newtcolorbox{crossreference}{
  colback=orange!5!white,
  colframe=orange!75!black,
  title={\textbf{Related Components}},
  breakable,
  enhanced,
  attach boxed title to top left={yshift=-2mm, xshift=2mm},
  boxed title style={size=small,colback=orange!75!black},
  before upper={\parindent15pt}
}

% Chapter and section styling
\usepackage{titlesec}
\usepackage{fancyhdr}
\usepackage{truncate}

% Customize chapter titles with automatic numbering
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries}
  {\chaptertitlename\ \thechapter}
  {20pt}
  {\Huge}

% Customize unnumbered chapter titles (for foreword)
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\huge\bfseries}
  {}
  {20pt}
  {\Huge}

% Customize section titles
\titleformat{\section}
  {\normalfont\Large\bfseries}
  {\thesection}
  {1em}
  {}

% Fix running headers to prevent overfull hbox
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[LO]{\nouppercase{\leftmark}}
\fancyhead[RE]{\nouppercase{\rightmark}}
\renewcommand{\headrulewidth}{0.4pt}

% Fix header height warning
\setlength{\headheight}{14pt}

% Links and URLs - hyperref already loaded above
\usepackage{url}

% Bibliography
$if(natbib)$
\usepackage{natbib}
\bibliographystyle{$if(biblio-style)$$biblio-style$$else$plainnat$endif$}
$endif$

$if(biblatex)$
\usepackage[$if(biblio-style)$style=$biblio-style$,$endif$$for(biblatexoptions)$$biblatexoptions$$sep$,$endfor$]{biblatex}
$for(bibliography)$
\addbibresource{$bibliography$}
$endfor$
$endif$

% Index
$if(book-style)$
\usepackage{makeidx}
\makeindex
$endif$

% Header includes
$for(header-includes)$
$header-includes$
$endfor$

% Title page
\title{$title$$if(subtitle)$\\[0.5em]{\large $subtitle$}$endif$}
$if(author)$
\author{$for(author)$$author$$sep$ \and $endfor$}
$endif$
$if(date)$
\date{$date$}
$endif$

% Stamp the edition under the date, matching book-print.latex. Reviewers end up with
% several drafts open and no way to tell them apart.
$if(edition)$
\date{$if(date)$$date$\\[0.8em]$endif$\normalsize\textit{$edition$}}
$endif$

\begin{document}

% Title page
$if(title)$
\maketitle
$endif$

% Copyright page -- REMOVED, same as book-print.latex. The publisher supplies it.
%
% Deleted rather than commented, and this comment deliberately contains no pandoc
% variables: pandoc expands them before LaTeX sees the percent signs, so commenting the
% block broke the build once, and naming a variable inside the explanation then printed
% that variable's text onto page two. A pandoc template cannot comment out a directive.
%
% The edition now prints on the title page instead. To restore the page, take the block
% from git history; the fields it read are still live in templates/metadata.yaml.


% Table of contents
$if(toc)$
{
$if(colorlinks)$
\hypersetup{linkcolor=$if(toccolor)$$toccolor$$else$black$endif$}
$endif$
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
}
$endif$

% Ensure hyperref is properly configured for internal links
\hypersetup{
$if(title-meta)$
  pdftitle={$title-meta$},
$endif$
$if(author-meta)$
  pdfauthor={$author-meta$},
$endif$
$if(subject)$
  pdfsubject={$subject$},
$endif$
$if(keywords)$
  pdfkeywords={$keywords$},
$endif$
$if(colorlinks)$
  colorlinks=true,
  linkcolor=$if(linkcolor)$$linkcolor$$else$black$endif$,
  citecolor=$if(citecolor)$$citecolor$$else$Blue$endif$,
  urlcolor=$if(urlcolor)$$urlcolor$$else$Blue$endif$,
$else$
  hidelinks,
$endif$
  breaklinks=true,
  bookmarks=true,
  bookmarksnumbered=true,
  bookmarksopen=false,
  pdfstartview=FitH
}

% List of figures
$if(lof)$
\listoffigures
$endif$

% List of tables
$if(lot)$
\listoftables
$endif$

% Main content
$body$

% Bibliography
$if(natbib)$
$if(bibliography)$
$if(biblio-title)$
$if(book-class)$
\renewcommand\bibname{$biblio-title$}
$else$
\renewcommand\refname{$biblio-title$}
$endif$
$endif$
\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}
$endif$
$endif$

$if(biblatex)$
\printbibliography$if(biblio-title)$[title=$biblio-title$]$endif$
$endif$

% Index
$if(book-style)$
\printindex
$endif$

\end{document}
