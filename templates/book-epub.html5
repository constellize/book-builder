<?xml version="1.0" encoding="UTF-8"?>
<!-- Copy of `pandoc -D epub3` (pandoc 3.8.3) with ONE addition: the $edition$ block
     on the title page, marked below. Nothing else differs - diff against
     `pandoc -D epub3` when upgrading pandoc.

     Why it exists: removing our copyright page (the publisher supplies theirs) removed
     the only place the EPUB stated its version. The PDF targets compensated with a
     title-page edition stamp; the EPUB used pandoc's built-in template and silently
     got nothing, so a reader had no way to tell which draft they held. -->
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops"$if(lang)$ lang="$lang$" xml:lang="$lang$"$endif$>
<head>
  <meta charset="utf-8" />
  <meta name="generator" content="pandoc" />
  <title>$pagetitle$</title>
  <style>
    /* Added with the $edition$ block below; pandoc's default epub.css has no rule
       for it, so without this the draft marker renders as ordinary body text. */
    p.edition { font-style: italic; text-align: center; margin-top: 1.5em; }
$if(csl-css)$
    $styles.citations.html()$
$endif$
$if(highlighting-css)$
    /* CSS for syntax highlighting */
    $highlighting-css$
$endif$
  </style>
$for(css)$
  <link rel="stylesheet" type="text/css" href="$css$" />
$endfor$
$for(header-includes)$
  $header-includes$
$endfor$
</head>
<body$if(coverpage)$ id="cover"$endif$$if(body-type)$ epub:type="$body-type$"$endif$>
$if(titlepage)$
<section epub:type="titlepage" class="titlepage">
$for(title)$
$if(title.type)$
  <h1 class="$title.type$">$title.text$</h1>
$else$
  <h1 class="title">$title$</h1>
$endif$
$endfor$
$if(subtitle)$
  <p class="subtitle">$subtitle$</p>
$endif$
$for(author)$
  <p class="author">$author$</p>
$endfor$
$for(creator)$
  <p class="$creator.role$">$creator.text$</p>
$endfor$
$if(publisher)$
  <p class="publisher">$publisher$</p>
$endif$
$if(date)$
  <p class="date">$date$</p>
$endif$
$if(edition)$
  <p class="edition">$edition$</p>
$endif$
$if(rights)$
  <div class="rights">$rights$</div>
$endif$
$if(abstract)$
<div class="abstract">
<div class="abstract-title">$abstract-title$</div>
$abstract$
</div>
$endif$
</section>
$else$
$if(coverpage)$
<div id="cover-image">
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="100%" height="100%" viewBox="0 0 $cover-image-width$ $cover-image-height$" preserveAspectRatio="xMidYMid">
<image width="$cover-image-width$" height="$cover-image-height$" xlink:href="../media/$cover-image$" />
</svg>
</div>
$else$
$for(include-before)$
$include-before$
$endfor$
$body$
$for(include-after)$
$include-after$
$endfor$
$endif$
$endif$
</body>
</html>

